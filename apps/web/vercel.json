{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web/browser",
  "installCommand": "npm install",
  "framework": "angular",
  "redirects": [
    {
      "source": "/openapi.json",
      "destination": "/api/docs-json",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\""
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/hire-path-job/:path*",
      "destination": "https://hire-path-jobs-web.vercel.app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://hire-path-jobs-api.vercel.app/api/:path*"
    }
  ]
}
