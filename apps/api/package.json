{
  "name": "hire-path-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "npm run build && concurrently -k \"npm run dev:tsc\" \"npm run dev:node\"",
    "dev:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:node": "node --watch dist/main.js",
    "dev:worker": "npm run build && concurrently -k \"npm run dev:tsc\" \"node --watch dist/worker.main.js\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.15.0",
    "bullmq": "^5.77.6",
    "cache-manager": "^7.2.8",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "joi": "^18.1.2",
    "jsdom": "^26.1.0",
    "keyv": "^5.6.0",
    "lru-cache": "^11.3.5",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
