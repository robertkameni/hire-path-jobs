{
  "name": "hire-path-jobs",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "start:api": "npm --workspace=apps/api run dev",
    "start:api:worker": "npm --workspace=apps/api run dev:worker",
    "start:web": "npm run start -w web",
    "biome:check": "biome check .",
    "biome:write": "biome check --write --unsafe .",
    "biome:ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0"
  }
}
